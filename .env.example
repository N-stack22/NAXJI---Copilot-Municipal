# En local deje vacio: Vite usa el proxy /api -> http://127.0.0.1:8000
# Si publica el front por separado, apunte a la URL del backend de Nathalie:
# VITE_API_URL=http://127.0.0.1:8000

# Configure lo siguiente en .env.local, sin sobrescribir su .env PostgreSQL.
# Nunca utilice prefijo VITE_ para variables NAXJI_DB_* ni secretos de sesiones.
NAXJI_PERSISTENCE_MODE=postgres
NAXJI_AUTH_MODE=supabase
NAXJI_SUPABASE_URL=https://SU_PROYECTO.supabase.co
NAXJI_SUPABASE_PUBLISHABLE_KEY=SU_CLAVE_PUBLICABLE_O_ANON
# false exclusivamente para desarrollo local por HTTP. En HTTPS use true.
NAXJI_AUTH_COOKIE_SECURE=false
NAXJI_AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Solo backend; nunca usar prefijo VITE_ para la conexión de Ollama.
NAXJI_OLLAMA_BASE_URL=http://localhost:11434
NAXJI_OLLAMA_MODEL=qwen2.5:7b
# Límite total de la petición, incluido cargar el modelo (1..1800 segundos).
NAXJI_OLLAMA_TIMEOUT_SECONDS=300

# PMV2: activar SOLO después de revisar/aplicar migraciones y configurar bucket privado.
NAXJI_RAG_ENABLED=false
NAXJI_STORAGE_BUCKET=naxji-documentos
# Solo backend, clave de servicio de Storage; nunca VITE_, nunca versionar el valor real.
NAXJI_STORAGE_SERVICE_KEY=
NAXJI_DOCUMENT_MAX_BYTES=10485760
NAXJI_DOCUMENT_FORMATS=pdf,docx,txt
NAXJI_EMBEDDING_MODEL=bge-m3:567m
NAXJI_EMBEDDING_DIMENSION=1024
NAXJI_EMBEDDING_TIMEOUT_SECONDS=120
NAXJI_RAG_CHUNK_SIZE=1200
NAXJI_RAG_CHUNK_OVERLAP=180
NAXJI_RAG_MAX_CHUNKS=2000
NAXJI_RAG_TOP_K=6
# Similitud coseno 1-distancia: mayor es mejor. Umbral inicial, calibrar corpus propio.
NAXJI_RAG_MIN_SIMILARITY=0.5
NAXJI_RAG_CONTEXT_CHARS=8000
NAXJI_RAG_LEASE_SECONDS=1800
# Incremente al cambiar pesos/digest o extracción: obliga a reindexar antes de recuperar.
NAXJI_RAG_PROCESSING_REVISION=1
