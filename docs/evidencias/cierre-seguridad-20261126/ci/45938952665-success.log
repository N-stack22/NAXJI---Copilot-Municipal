2026-11-27T04:18:05.2406562Z  	    RAISE EXCEPTION 'Faltan las migraciones de secciones o título por versión; revisar prerrequisitos';
2026-11-27T04:18:05.2406614Z  	  END IF;
2026-11-27T04:18:05.2406694Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:18:05.2406795Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:18:05.2406883Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:18:05.2406980Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:18:05.2407048Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
2026-11-27T04:18:05.2407209Z  	    RAISE EXCEPTION 'Se requieren INFORME_INSPECCION y MDT_SGGA activos; no se insertaron registros';
2026-11-27T04:18:05.2407258Z  	  END IF;
2026-11-27T04:18:05.2407302Z  	
2026-11-27T04:18:05.2407382Z  	  SELECT * INTO v_plantilla FROM public.plantillas
2026-11-27T04:18:05.2407514Z  	    WHERE nombre=v_definicion->>'nombre' AND version=(v_definicion->>'version')::integer
2026-11-27T04:18:05.2407561Z  	    FOR UPDATE;
2026-11-27T04:18:05.2407610Z  	  IF FOUND THEN
2026-11-27T04:18:05.2407734Z  	    -- Una versión existente debe coincidir COMPLETA, incluidos campos inactivos.
2026-11-27T04:18:05.2407903Z  	    -- Una versión parcial también se rechaza; no se rellena silenciosamente.
2026-11-27T04:18:05.2408023Z  	    IF (v_plantilla.tipo_informe_id,v_plantilla.area_id,v_plantilla.activa,
2026-11-27T04:18:05.2408119Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:18:05.2408225Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
2026-11-27T04:18:05.2408344Z  	                        v_definicion->>'descripcion',v_definicion->'secciones_salida') THEN
