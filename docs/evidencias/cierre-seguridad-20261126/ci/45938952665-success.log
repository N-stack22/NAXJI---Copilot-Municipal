2026-11-27T04:18:05.2026328Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:18:05.2026495Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:18:05.2026580Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:18:05.2026678Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
