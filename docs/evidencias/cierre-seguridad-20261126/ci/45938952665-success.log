2026-11-27T04:18:05.2197249Z  	    RETURNING id INTO v_plantilla_id;
2026-11-27T04:18:05.2197446Z  	  INSERT INTO public.campos_plantilla(plantilla_id,clave,etiqueta,tipo_dato,obligatorio,orden,configuracion,activo)
2026-11-27T04:18:05.2197614Z  	    SELECT v_plantilla_id,c.clave,c.etiqueta,c.tipo_dato,c.obligatorio,c.orden,c.configuracion,c.activo
2026-11-27T04:18:05.2197701Z  	    FROM jsonb_to_recordset(v_definicion->'campos') AS c(
