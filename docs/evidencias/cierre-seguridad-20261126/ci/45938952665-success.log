2026-11-27T04:18:05.2047151Z  	            (v_definicion->>'activa')::boolean,v_definicion->>'descripcion',v_definicion->'secciones_salida')
2026-11-27T04:18:05.2047214Z  	    RETURNING id INTO v_plantilla_id;
