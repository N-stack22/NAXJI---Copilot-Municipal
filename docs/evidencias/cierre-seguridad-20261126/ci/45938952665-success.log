2026-11-27T04:18:05.2443575Z  	) AS v(clave,etiqueta,tipo_dato,obligatorio,orden,configuracion);
2026-11-27T04:18:05.2443622Z  	
2026-11-27T04:18:05.2443667Z  	DO $$ BEGIN
2026-11-27T04:18:05.2443748Z  	  IF EXISTS (SELECT 1 FROM public.campos_plantilla c
2026-11-27T04:18:05.2443829Z  	    JOIN public.plantillas p ON p.id=c.plantilla_id
2026-11-27T04:18:05.2443902Z  	    LEFT JOIN naxji_fuentes_v2 v ON v.clave=c.clave
2026-11-27T04:18:05.2444003Z  	    WHERE p.nombre='Informe Técnico – Piloto NAXJI' AND p.version=2
2026-11-27T04:18:05.2444168Z  	    AND (v.clave IS NULL OR (c.etiqueta,c.tipo_dato,c.obligatorio,c.orden,c.configuracion,c.activo)
2026-11-27T04:18:05.2444323Z  	      IS DISTINCT FROM (v.etiqueta,v.tipo_dato,v.obligatorio,v.orden,v.configuracion,true))) THEN
2026-11-27T04:18:05.2444455Z  	    RAISE EXCEPTION 'Los campos de v2 existentes difieren; no se alteraron registros';
2026-11-27T04:18:05.2444503Z  	  END IF;
2026-11-27T04:18:05.2444559Z  	END $$;
2026-11-27T04:18:05.2444607Z  	
2026-11-27T04:18:05.2444800Z  	INSERT INTO public.campos_plantilla(plantilla_id,clave,etiqueta,tipo_dato,obligatorio,orden,configuracion)
2026-11-27T04:18:05.2444931Z  	SELECT p.id,v.clave,v.etiqueta,v.tipo_dato,v.obligatorio,v.orden,v.configuracion
2026-11-27T04:18:05.2445025Z  	FROM naxji_fuentes_v2 v CROSS JOIN public.plantillas p
2026-11-27T04:18:05.2445125Z  	WHERE p.nombre='Informe Técnico – Piloto NAXJI' AND p.version=2
2026-11-27T04:18:05.2445192Z  	ON CONFLICT(plantilla_id,clave) DO NOTHING;
