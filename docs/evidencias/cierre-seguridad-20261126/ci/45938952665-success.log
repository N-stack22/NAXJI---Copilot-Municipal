2026-11-27T04:18:05.2042887Z  	
2026-11-27T04:18:05.2043012Z  	  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:18:05.2043116Z  	      AND table_name='plantillas' AND column_name='secciones_salida')
2026-11-27T04:18:05.2043247Z  	    OR NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:18:05.2043350Z  	      AND table_name='versiones_informe' AND column_name='titulo') THEN
2026-11-27T04:18:05.2043512Z  	    RAISE EXCEPTION 'Faltan las migraciones de secciones o título por versión; revisar prerrequisitos';
2026-11-27T04:18:05.2043561Z  	  END IF;
2026-11-27T04:18:05.2043643Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:18:05.2043742Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:18:05.2043915Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:18:05.2044021Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:18:05.2044094Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
2026-11-27T04:18:05.2044263Z  	    RAISE EXCEPTION 'Se requieren INFORME_INSPECCION y MDT_SGGA activos; no se insertaron registros';
2026-11-27T04:18:05.2044314Z  	  END IF;
2026-11-27T04:18:05.2044357Z  	
2026-11-27T04:18:05.2044439Z  	  SELECT * INTO v_plantilla FROM public.plantillas
2026-11-27T04:18:05.2044579Z  	    WHERE nombre=v_definicion->>'nombre' AND version=(v_definicion->>'version')::integer
2026-11-27T04:18:05.2044626Z  	    FOR UPDATE;
2026-11-27T04:18:05.2044677Z  	  IF FOUND THEN
2026-11-27T04:18:05.2044800Z  	    -- Una versión existente debe coincidir COMPLETA, incluidos campos inactivos.
2026-11-27T04:18:05.2044911Z  	    -- Una versión parcial también se rechaza; no se rellena silenciosamente.
2026-11-27T04:18:05.2045097Z  	    IF (v_plantilla.tipo_informe_id,v_plantilla.area_id,v_plantilla.activa,
2026-11-27T04:18:05.2045190Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:18:05.2045298Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
2026-11-27T04:18:05.2045416Z  	                        v_definicion->>'descripcion',v_definicion->'secciones_salida') THEN
2026-11-27T04:18:05.2045567Z  	      RAISE EXCEPTION 'La plantilla de inspección v1 existente difiere; revisar sin sobrescribir';
2026-11-27T04:18:05.2045612Z  	    END IF;
2026-11-27T04:18:05.2045684Z  	    SELECT COALESCE(jsonb_agg(jsonb_build_object(
2026-11-27T04:18:05.2045783Z  	        'clave',c.clave,'etiqueta',c.etiqueta,'tipo_dato',c.tipo_dato,
2026-11-27T04:18:05.2045932Z  	        'obligatorio',c.obligatorio,'orden',c.orden,'configuracion',c.configuracion,'activo',c.activo)
2026-11-27T04:18:05.2045998Z  	        ORDER BY c.orden,c.clave),'[]'::jsonb)
2026-11-27T04:18:05.2046150Z  	      INTO v_campos_actuales FROM public.campos_plantilla c WHERE c.plantilla_id=v_plantilla.id;
2026-11-27T04:18:05.2046251Z  	    IF v_campos_actuales IS DISTINCT FROM v_definicion->'campos' THEN
2026-11-27T04:18:05.2046431Z  	      RAISE EXCEPTION 'Los campos de inspección existentes difieren o están incompletos; revisar sin sobrescribir';
2026-11-27T04:18:05.2046480Z  	    END IF;
2026-11-27T04:18:05.2046583Z  	    RETURN; -- Coincide: cero escrituras, sin cambiar IDs ni timestamps.
2026-11-27T04:18:05.2046630Z  	  END IF;
