2026-11-27T04:18:05.2406062Z  	  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:18:05.2406169Z  	      AND table_name='plantillas' AND column_name='secciones_salida')
