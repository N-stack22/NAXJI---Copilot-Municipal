2026-11-27T04:18:05.2078512Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:18:05.2078595Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
2026-11-27T04:18:05.2078749Z  	    RAISE EXCEPTION 'Se requieren INFORME_INSPECCION y MDT_SGGA activos; no se insertaron registros';
2026-11-27T04:18:05.2078801Z  	  END IF;
2026-11-27T04:18:05.2078849Z  	
2026-11-27T04:18:05.2078923Z  	  SELECT * INTO v_plantilla FROM public.plantillas
2026-11-27T04:18:05.2079056Z  	    WHERE nombre=v_definicion->>'nombre' AND version=(v_definicion->>'version')::integer
2026-11-27T04:18:05.2079108Z  	    FOR UPDATE;
2026-11-27T04:18:05.2079153Z  	  IF FOUND THEN
2026-11-27T04:18:05.2079279Z  	    -- Una versión existente debe coincidir COMPLETA, incluidos campos inactivos.
2026-11-27T04:18:05.2079394Z  	    -- Una versión parcial también se rechaza; no se rellena silenciosamente.
2026-11-27T04:18:05.2079502Z  	    IF (v_plantilla.tipo_informe_id,v_plantilla.area_id,v_plantilla.activa,
2026-11-27T04:18:05.2079597Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:18:05.2079715Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
2026-11-27T04:18:05.2079828Z  	                        v_definicion->>'descripcion',v_definicion->'secciones_salida') THEN
2026-11-27T04:18:05.2079981Z  	      RAISE EXCEPTION 'La plantilla de inspección v1 existente difiere; revisar sin sobrescribir';
2026-11-27T04:18:05.2080030Z  	    END IF;
2026-11-27T04:18:05.2080104Z  	    SELECT COALESCE(jsonb_agg(jsonb_build_object(
2026-11-27T04:18:05.2080276Z  	        'clave',c.clave,'etiqueta',c.etiqueta,'tipo_dato',c.tipo_dato,
2026-11-27T04:18:05.2080427Z  	        'obligatorio',c.obligatorio,'orden',c.orden,'configuracion',c.configuracion,'activo',c.activo)
2026-11-27T04:18:05.2080499Z  	        ORDER BY c.orden,c.clave),'[]'::jsonb)
2026-11-27T04:18:05.2080645Z  	      INTO v_campos_actuales FROM public.campos_plantilla c WHERE c.plantilla_id=v_plantilla.id;
2026-11-27T04:18:05.2080746Z  	    IF v_campos_actuales IS DISTINCT FROM v_definicion->'campos' THEN
2026-11-27T04:18:05.2081018Z  	      RAISE EXCEPTION 'Los campos de inspección existentes difieren o están incompletos; revisar sin sobrescribir';
2026-11-27T04:18:05.2081067Z  	    END IF;
2026-11-27T04:18:05.2081176Z  	    RETURN; -- Coincide: cero escrituras, sin cambiar IDs ni timestamps.
2026-11-27T04:18:05.2081227Z  	  END IF;
2026-11-27T04:18:05.2081271Z  	
2026-11-27T04:18:05.2081454Z  	  INSERT INTO public.plantillas(nombre,tipo_informe_id,area_id,version,activa,descripcion,secciones_salida)
2026-11-27T04:18:05.2081590Z  	    VALUES (v_definicion->>'nombre',v_tipo_id,v_area_id,(v_definicion->>'version')::integer,
2026-11-27T04:18:05.2081744Z  	            (v_definicion->>'activa')::boolean,v_definicion->>'descripcion',v_definicion->'secciones_salida')
2026-11-27T04:18:05.2081810Z  	    RETURNING id INTO v_plantilla_id;
2026-11-27T04:18:05.2082008Z  	  INSERT INTO public.campos_plantilla(plantilla_id,clave,etiqueta,tipo_dato,obligatorio,orden,configuracion,activo)
2026-11-27T04:18:05.2082179Z  	    SELECT v_plantilla_id,c.clave,c.etiqueta,c.tipo_dato,c.obligatorio,c.orden,c.configuracion,c.activo
2026-11-27T04:18:05.2082350Z  	    FROM jsonb_to_recordset(v_definicion->'campos') AS c(
2026-11-27T04:18:05.2082533Z  	      clave text,etiqueta text,tipo_dato text,obligatorio boolean,orden integer,configuracion jsonb,activo boolean);
2026-11-27T04:18:05.2082652Z  	  -- Si cualquier inserción falla, PostgreSQL revierte TODA esta sentencia DO.
2026-11-27T04:18:05.2082698Z  	END
