2026-11-27T04:18:05.2192352Z  	  $definicion_inspeccion$::jsonb;
2026-11-27T04:18:05.2192405Z  	  v_tipo_id uuid;
2026-11-27T04:18:05.2192459Z  	  v_area_id uuid;
2026-11-27T04:18:05.2192524Z  	  v_plantilla public.plantillas%ROWTYPE;
2026-11-27T04:18:05.2192582Z  	  v_campos_actuales jsonb;
2026-11-27T04:18:05.2192637Z  	  v_plantilla_id uuid;
2026-11-27T04:18:05.2192681Z  	BEGIN
2026-11-27T04:18:05.2192757Z  	  PERFORM set_config('lock_timeout', '5s', true);
2026-11-27T04:18:05.2192831Z  	  PERFORM pg_advisory_xact_lock(20261001, 3);
2026-11-27T04:18:05.2192877Z  	
2026-11-27T04:18:05.2193005Z  	  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:18:05.2193110Z  	      AND table_name='plantillas' AND column_name='secciones_salida')
2026-11-27T04:18:05.2193233Z  	    OR NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:18:05.2193445Z  	      AND table_name='versiones_informe' AND column_name='titulo') THEN
2026-11-27T04:18:05.2193613Z  	    RAISE EXCEPTION 'Faltan las migraciones de secciones o título por versión; revisar prerrequisitos';
2026-11-27T04:18:05.2193657Z  	  END IF;
2026-11-27T04:18:05.2193739Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:18:05.2193837Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:18:05.2193920Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:18:05.2194016Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:18:05.2194087Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
2026-11-27T04:18:05.2194241Z  	    RAISE EXCEPTION 'Se requieren INFORME_INSPECCION y MDT_SGGA activos; no se insertaron registros';
2026-11-27T04:18:05.2194290Z  	  END IF;
2026-11-27T04:18:05.2194337Z  	
2026-11-27T04:18:05.2194413Z  	  SELECT * INTO v_plantilla FROM public.plantillas
2026-11-27T04:18:05.2194548Z  	    WHERE nombre=v_definicion->>'nombre' AND version=(v_definicion->>'version')::integer
2026-11-27T04:18:05.2194682Z  	    FOR UPDATE;
2026-11-27T04:18:05.2194729Z  	  IF FOUND THEN
2026-11-27T04:18:05.2194856Z  	    -- Una versión existente debe coincidir COMPLETA, incluidos campos inactivos.
2026-11-27T04:18:05.2194973Z  	    -- Una versión parcial también se rechaza; no se rellena silenciosamente.
2026-11-27T04:18:05.2195082Z  	    IF (v_plantilla.tipo_informe_id,v_plantilla.area_id,v_plantilla.activa,
2026-11-27T04:18:05.2195177Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:18:05.2195290Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
2026-11-27T04:18:05.2195404Z  	                        v_definicion->>'descripcion',v_definicion->'secciones_salida') THEN
2026-11-27T04:18:05.2195557Z  	      RAISE EXCEPTION 'La plantilla de inspección v1 existente difiere; revisar sin sobrescribir';
2026-11-27T04:18:05.2195608Z  	    END IF;
2026-11-27T04:18:05.2195690Z  	    SELECT COALESCE(jsonb_agg(jsonb_build_object(
2026-11-27T04:18:05.2195793Z  	        'clave',c.clave,'etiqueta',c.etiqueta,'tipo_dato',c.tipo_dato,
2026-11-27T04:18:05.2195948Z  	        'obligatorio',c.obligatorio,'orden',c.orden,'configuracion',c.configuracion,'activo',c.activo)
2026-11-27T04:18:05.2196015Z  	        ORDER BY c.orden,c.clave),'[]'::jsonb)
2026-11-27T04:18:05.2196166Z  	      INTO v_campos_actuales FROM public.campos_plantilla c WHERE c.plantilla_id=v_plantilla.id;
2026-11-27T04:18:05.2196267Z  	    IF v_campos_actuales IS DISTINCT FROM v_definicion->'campos' THEN
2026-11-27T04:18:05.2196452Z  	      RAISE EXCEPTION 'Los campos de inspección existentes difieren o están incompletos; revisar sin sobrescribir';
2026-11-27T04:18:05.2196497Z  	    END IF;
2026-11-27T04:18:05.2196605Z  	    RETURN; -- Coincide: cero escrituras, sin cambiar IDs ni timestamps.
2026-11-27T04:18:05.2196657Z  	  END IF;
