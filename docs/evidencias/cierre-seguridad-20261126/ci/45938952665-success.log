2026-11-27T04:18:05.1995948Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:18:05.1996174Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
