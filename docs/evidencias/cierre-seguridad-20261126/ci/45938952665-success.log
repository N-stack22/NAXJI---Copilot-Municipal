2026-11-27T04:18:05.2408931Z  	        ORDER BY c.orden,c.clave),'[]'::jsonb)
2026-11-27T04:18:05.2409146Z  	      INTO v_campos_actuales FROM public.campos_plantilla c WHERE c.plantilla_id=v_plantilla.id;
2026-11-27T04:18:05.2409247Z  	    IF v_campos_actuales IS DISTINCT FROM v_definicion->'campos' THEN
2026-11-27T04:18:05.2409424Z  	      RAISE EXCEPTION 'Los campos de inspección existentes difieren o están incompletos; revisar sin sobrescribir';
2026-11-27T04:18:05.2409474Z  	    END IF;
