2026-11-27T04:18:05.2427486Z  	  $definicion_inspeccion$::jsonb;
2026-11-27T04:18:05.2427533Z  	  v_tipo_id uuid;
2026-11-27T04:18:05.2427586Z  	  v_area_id uuid;
2026-11-27T04:18:05.2427655Z  	  v_plantilla public.plantillas%ROWTYPE;
2026-11-27T04:18:05.2427708Z  	  v_campos_actuales jsonb;
2026-11-27T04:18:05.2427763Z  	  v_plantilla_id uuid;
2026-11-27T04:18:05.2427814Z  	BEGIN
2026-11-27T04:18:05.2427887Z  	  PERFORM set_config('lock_timeout', '5s', true);
2026-11-27T04:18:05.2427959Z  	  PERFORM pg_advisory_xact_lock(20261001, 3);
2026-11-27T04:18:05.2428004Z  	
2026-11-27T04:18:05.2428131Z  	  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:18:05.2428237Z  	      AND table_name='plantillas' AND column_name='secciones_salida')
2026-11-27T04:18:05.2428365Z  	    OR NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:18:05.2428468Z  	      AND table_name='versiones_informe' AND column_name='titulo') THEN
2026-11-27T04:18:05.2428630Z  	    RAISE EXCEPTION 'Faltan las migraciones de secciones o título por versión; revisar prerrequisitos';
2026-11-27T04:18:05.2428678Z  	  END IF;
2026-11-27T04:18:05.2428753Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:18:05.2428854Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:18:05.2428942Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:18:05.2429040Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:18:05.2429110Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
2026-11-27T04:18:05.2429268Z  	    RAISE EXCEPTION 'Se requieren INFORME_INSPECCION y MDT_SGGA activos; no se insertaron registros';
2026-11-27T04:18:05.2429318Z  	  END IF;
2026-11-27T04:18:05.2429361Z  	
2026-11-27T04:18:05.2429440Z  	  SELECT * INTO v_plantilla FROM public.plantillas
2026-11-27T04:18:05.2429577Z  	    WHERE nombre=v_definicion->>'nombre' AND version=(v_definicion->>'version')::integer
2026-11-27T04:18:05.2429628Z  	    FOR UPDATE;
2026-11-27T04:18:05.2429679Z  	  IF FOUND THEN
2026-11-27T04:18:05.2429806Z  	    -- Una versión existente debe coincidir COMPLETA, incluidos campos inactivos.
2026-11-27T04:18:05.2429916Z  	    -- Una versión parcial también se rechaza; no se rellena silenciosamente.
2026-11-27T04:18:05.2430030Z  	    IF (v_plantilla.tipo_informe_id,v_plantilla.area_id,v_plantilla.activa,
2026-11-27T04:18:05.2430124Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:18:05.2430313Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
2026-11-27T04:18:05.2430433Z  	                        v_definicion->>'descripcion',v_definicion->'secciones_salida') THEN
2026-11-27T04:18:05.2430584Z  	      RAISE EXCEPTION 'La plantilla de inspección v1 existente difiere; revisar sin sobrescribir';
2026-11-27T04:18:05.2430629Z  	    END IF;
2026-11-27T04:18:05.2430790Z  	    SELECT COALESCE(jsonb_agg(jsonb_build_object(
2026-11-27T04:18:05.2430893Z  	        'clave',c.clave,'etiqueta',c.etiqueta,'tipo_dato',c.tipo_dato,
2026-11-27T04:18:05.2431044Z  	        'obligatorio',c.obligatorio,'orden',c.orden,'configuracion',c.configuracion,'activo',c.activo)
2026-11-27T04:18:05.2431114Z  	        ORDER BY c.orden,c.clave),'[]'::jsonb)
2026-11-27T04:18:05.2431269Z  	      INTO v_campos_actuales FROM public.campos_plantilla c WHERE c.plantilla_id=v_plantilla.id;
2026-11-27T04:18:05.2431367Z  	    IF v_campos_actuales IS DISTINCT FROM v_definicion->'campos' THEN
2026-11-27T04:18:05.2431547Z  	      RAISE EXCEPTION 'Los campos de inspección existentes difieren o están incompletos; revisar sin sobrescribir';
2026-11-27T04:18:05.2431598Z  	    END IF;
2026-11-27T04:18:05.2431703Z  	    RETURN; -- Coincide: cero escrituras, sin cambiar IDs ni timestamps.
2026-11-27T04:18:05.2431753Z  	  END IF;
2026-11-27T04:18:05.2431799Z  	
2026-11-27T04:18:05.2431980Z  	  INSERT INTO public.plantillas(nombre,tipo_informe_id,area_id,version,activa,descripcion,secciones_salida)
2026-11-27T04:18:05.2432204Z  	    VALUES (v_definicion->>'nombre',v_tipo_id,v_area_id,(v_definicion->>'version')::integer,
2026-11-27T04:18:05.2432363Z  	            (v_definicion->>'activa')::boolean,v_definicion->>'descripcion',v_definicion->'secciones_salida')
2026-11-27T04:18:05.2432426Z  	    RETURNING id INTO v_plantilla_id;
2026-11-27T04:18:05.2432620Z  	  INSERT INTO public.campos_plantilla(plantilla_id,clave,etiqueta,tipo_dato,obligatorio,orden,configuracion,activo)
2026-11-27T04:18:05.2432797Z  	    SELECT v_plantilla_id,c.clave,c.etiqueta,c.tipo_dato,c.obligatorio,c.orden,c.configuracion,c.activo
2026-11-27T04:18:05.2432886Z  	    FROM jsonb_to_recordset(v_definicion->'campos') AS c(
2026-11-27T04:18:05.2433068Z  	      clave text,etiqueta text,tipo_dato text,obligatorio boolean,orden integer,configuracion jsonb,activo boolean);
2026-11-27T04:18:05.2433191Z  	  -- Si cualquier inserción falla, PostgreSQL revierte TODA esta sentencia DO.
2026-11-27T04:18:05.2433242Z  	END
