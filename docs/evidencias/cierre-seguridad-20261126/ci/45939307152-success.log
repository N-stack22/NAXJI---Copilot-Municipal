2026-11-27T04:21:49.4989128Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:21:49.4989269Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
