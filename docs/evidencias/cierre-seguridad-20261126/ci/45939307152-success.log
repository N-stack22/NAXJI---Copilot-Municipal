2026-11-27T04:21:49.5029127Z  	  ('referencias_conocidas','Documentos y referencias conocidos','textarea',false,5,
2026-11-27T04:21:49.5029539Z  	   '{"rol_fuente":"referencias","ayuda":"Opcional. Identifique documentos, enlaces o extractos disponibles. Un número o enlace no acredita su contenido, vigencia ni aplicabilidad."}'::jsonb),
2026-11-27T04:21:49.5029738Z  	  ('informacion_pendiente','Información pendiente de obtener o verificar','textarea',false,6,
2026-11-27T04:21:49.5029999Z  	   '{"ayuda":"Opcional. Señale datos faltantes. No necesita redactar antecedentes, análisis ni conclusiones."}'::jsonb)
2026-11-27T04:21:49.5030147Z  	) AS v(clave,etiqueta,tipo_dato,obligatorio,orden,configuracion);
2026-11-27T04:21:49.5030206Z  	
2026-11-27T04:21:49.5030273Z  	DO $$ BEGIN
2026-11-27T04:21:49.5030383Z  	  IF EXISTS (SELECT 1 FROM public.campos_plantilla c
2026-11-27T04:21:49.5030483Z  	    JOIN public.plantillas p ON p.id=c.plantilla_id
2026-11-27T04:21:49.5030584Z  	    LEFT JOIN naxji_fuentes_v2 v ON v.clave=c.clave
2026-11-27T04:21:49.5030719Z  	    WHERE p.nombre='Informe Técnico – Piloto NAXJI' AND p.version=2
2026-11-27T04:21:49.5030931Z  	    AND (v.clave IS NULL OR (c.etiqueta,c.tipo_dato,c.obligatorio,c.orden,c.configuracion,c.activo)
2026-11-27T04:21:49.5031147Z  	      IS DISTINCT FROM (v.etiqueta,v.tipo_dato,v.obligatorio,v.orden,v.configuracion,true))) THEN
2026-11-27T04:21:49.5031322Z  	    RAISE EXCEPTION 'Los campos de v2 existentes difieren; no se alteraron registros';
2026-11-27T04:21:49.5031385Z  	  END IF;
2026-11-27T04:21:49.5031455Z  	END $$;
2026-11-27T04:21:49.5031519Z  	
2026-11-27T04:21:49.5031764Z  	INSERT INTO public.campos_plantilla(plantilla_id,clave,etiqueta,tipo_dato,obligatorio,orden,configuracion)
