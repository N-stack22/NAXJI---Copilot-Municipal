2026-11-27T04:21:49.4157349Z  	CREATE OR REPLACE FUNCTION public.naxji_secciones_salida_validas(valor jsonb)
2026-11-27T04:21:49.4157736Z  	RETURNS boolean LANGUAGE plpgsql IMMUTABLE SET search_path = pg_catalog AS $$
2026-11-27T04:21:49.4158019Z  	DECLARE
2026-11-27T04:21:49.4158168Z  	  seccion jsonb;
2026-11-27T04:21:49.4158349Z  	  claves text[] := ARRAY[]::text[];
2026-11-27T04:21:49.4158544Z  	  clave text;
2026-11-27T04:21:49.4158788Z  	  -- Caracteres Unicode que Python considera blancos (str.strip()). btrim()
2026-11-27T04:21:49.4159158Z  	  -- sin segundo argumento solo elimina U+0020; POSIX depende del locale.
2026-11-27T04:21:49.4159688Z  	  espacios constant text := U&'\0009\000A\000B\000C\000D\001C\001D\001E\001F\0020\0085\00A0\1680\2000\2001\2002\2003\2004\2005\2006\2007\2008\2009\200A\2028\2029\202F\205F\3000';
2026-11-27T04:21:49.4160168Z  	BEGIN
2026-11-27T04:21:49.4160347Z  	  IF valor IS NULL THEN RETURN true; END IF;
2026-11-27T04:21:49.4160610Z  	  IF jsonb_typeof(valor) <> 'array' THEN RETURN false; END IF;
2026-11-27T04:21:49.4160939Z  	  IF jsonb_array_length(valor) NOT BETWEEN 1 AND 100 THEN RETURN false; END IF;
2026-11-27T04:21:49.4161278Z  	  FOR seccion IN SELECT * FROM jsonb_array_elements(valor) LOOP
2026-11-27T04:21:49.4161589Z  	    IF jsonb_typeof(seccion) <> 'object' THEN RETURN false; END IF;
2026-11-27T04:21:49.4161887Z  	    IF NOT (seccion ?& ARRAY['clave','titulo','obligatoria'])
2026-11-27T04:21:49.4162248Z  	       OR (seccion - ARRAY['clave','titulo','obligatoria']) <> '{}'::jsonb THEN RETURN false; END IF;
2026-11-27T04:21:49.4162603Z  	    IF jsonb_typeof(seccion->'clave') <> 'string'
2026-11-27T04:21:49.4162858Z  	       OR jsonb_typeof(seccion->'titulo') <> 'string'
2026-11-27T04:21:49.4163170Z  	       OR jsonb_typeof(seccion->'obligatoria') <> 'boolean' THEN RETURN false; END IF;
2026-11-27T04:21:49.4163626Z  	    clave := seccion->>'clave';
2026-11-27T04:21:49.4163839Z  	    IF clave !~ '^[a-z][a-z0-9_]{0,79}$'
2026-11-27T04:21:49.4164218Z  	       OR clave = ANY(ARRAY['encabezado','datos','contexto','plantilla','instrucciones'])
2026-11-27T04:21:49.4164555Z  	       OR clave = ANY(claves)
