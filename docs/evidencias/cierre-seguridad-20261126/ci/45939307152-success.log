2026-11-27T04:21:49.4323265Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:21:49.4323696Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:21:49.4324069Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:21:49.4324400Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:21:49.4324689Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
