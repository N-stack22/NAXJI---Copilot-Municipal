2026-11-27T04:21:49.4446937Z  	
2026-11-27T04:21:49.4447102Z  	  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:21:49.4447249Z  	      AND table_name='plantillas' AND column_name='secciones_salida')
2026-11-27T04:21:49.4447421Z  	    OR NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:21:49.4447548Z  	      AND table_name='versiones_informe' AND column_name='titulo') THEN
2026-11-27T04:21:49.4447772Z  	    RAISE EXCEPTION 'Faltan las migraciones de secciones o título por versión; revisar prerrequisitos';
2026-11-27T04:21:49.4447838Z  	  END IF;
2026-11-27T04:21:49.4447938Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:21:49.4448073Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:21:49.4448188Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:21:49.4448314Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:21:49.4448412Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
2026-11-27T04:21:49.4448619Z  	    RAISE EXCEPTION 'Se requieren INFORME_INSPECCION y MDT_SGGA activos; no se insertaron registros';
2026-11-27T04:21:49.4448690Z  	  END IF;
2026-11-27T04:21:49.4448744Z  	
2026-11-27T04:21:49.4448841Z  	  SELECT * INTO v_plantilla FROM public.plantillas
2026-11-27T04:21:49.4449007Z  	    WHERE nombre=v_definicion->>'nombre' AND version=(v_definicion->>'version')::integer
2026-11-27T04:21:49.4449068Z  	    FOR UPDATE;
2026-11-27T04:21:49.4449134Z  	  IF FOUND THEN
2026-11-27T04:21:49.4449304Z  	    -- Una versión existente debe coincidir COMPLETA, incluidos campos inactivos.
2026-11-27T04:21:49.4449451Z  	    -- Una versión parcial también se rechaza; no se rellena silenciosamente.
2026-11-27T04:21:49.4449607Z  	    IF (v_plantilla.tipo_informe_id,v_plantilla.area_id,v_plantilla.activa,
2026-11-27T04:21:49.4449732Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:21:49.4449873Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
2026-11-27T04:21:49.4450055Z  	                        v_definicion->>'descripcion',v_definicion->'secciones_salida') THEN
2026-11-27T04:21:49.4450324Z  	      RAISE EXCEPTION 'La plantilla de inspección v1 existente difiere; revisar sin sobrescribir';
2026-11-27T04:21:49.4450386Z  	    END IF;
2026-11-27T04:21:49.4450489Z  	    SELECT COALESCE(jsonb_agg(jsonb_build_object(
2026-11-27T04:21:49.4450623Z  	        'clave',c.clave,'etiqueta',c.etiqueta,'tipo_dato',c.tipo_dato,
2026-11-27T04:21:49.4450818Z  	        'obligatorio',c.obligatorio,'orden',c.orden,'configuracion',c.configuracion,'activo',c.activo)
2026-11-27T04:21:49.4450912Z  	        ORDER BY c.orden,c.clave),'[]'::jsonb)
2026-11-27T04:21:49.4451113Z  	      INTO v_campos_actuales FROM public.campos_plantilla c WHERE c.plantilla_id=v_plantilla.id;
2026-11-27T04:21:49.4451243Z  	    IF v_campos_actuales IS DISTINCT FROM v_definicion->'campos' THEN
2026-11-27T04:21:49.4451494Z  	      RAISE EXCEPTION 'Los campos de inspección existentes difieren o están incompletos; revisar sin sobrescribir';
2026-11-27T04:21:49.4451593Z  	    END IF;
2026-11-27T04:21:49.4451736Z  	    RETURN; -- Coincide: cero escrituras, sin cambiar IDs ni timestamps.
2026-11-27T04:21:49.4451801Z  	  END IF;
2026-11-27T04:21:49.4451866Z  	
