2026-11-27T04:21:49.4987285Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:21:49.4987420Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
