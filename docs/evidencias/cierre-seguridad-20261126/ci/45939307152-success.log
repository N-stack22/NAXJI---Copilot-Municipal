2026-11-27T04:21:49.5009302Z  	  $definicion_inspeccion$::jsonb;
2026-11-27T04:21:49.5009374Z  	  v_tipo_id uuid;
2026-11-27T04:21:49.5009441Z  	  v_area_id uuid;
2026-11-27T04:21:49.5009526Z  	  v_plantilla public.plantillas%ROWTYPE;
2026-11-27T04:21:49.5009602Z  	  v_campos_actuales jsonb;
2026-11-27T04:21:49.5009676Z  	  v_plantilla_id uuid;
2026-11-27T04:21:49.5009734Z  	BEGIN
2026-11-27T04:21:49.5009837Z  	  PERFORM set_config('lock_timeout', '5s', true);
2026-11-27T04:21:49.5009932Z  	  PERFORM pg_advisory_xact_lock(20261001, 3);
2026-11-27T04:21:49.5009988Z  	
2026-11-27T04:21:49.5010162Z  	  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:21:49.5010301Z  	      AND table_name='plantillas' AND column_name='secciones_salida')
2026-11-27T04:21:49.5010470Z  	    OR NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:21:49.5010614Z  	      AND table_name='versiones_informe' AND column_name='titulo') THEN
2026-11-27T04:21:49.5010838Z  	    RAISE EXCEPTION 'Faltan las migraciones de secciones o título por versión; revisar prerrequisitos';
2026-11-27T04:21:49.5010894Z  	  END IF;
2026-11-27T04:21:49.5011000Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:21:49.5011130Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:21:49.5011237Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:21:49.5011365Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:21:49.5011460Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
2026-11-27T04:21:49.5011667Z  	    RAISE EXCEPTION 'Se requieren INFORME_INSPECCION y MDT_SGGA activos; no se insertaron registros';
2026-11-27T04:21:49.5011724Z  	  END IF;
2026-11-27T04:21:49.5011788Z  	
2026-11-27T04:21:49.5011898Z  	  SELECT * INTO v_plantilla FROM public.plantillas
2026-11-27T04:21:49.5012068Z  	    WHERE nombre=v_definicion->>'nombre' AND version=(v_definicion->>'version')::integer
2026-11-27T04:21:49.5012135Z  	    FOR UPDATE;
2026-11-27T04:21:49.5012203Z  	  IF FOUND THEN
2026-11-27T04:21:49.5012363Z  	    -- Una versión existente debe coincidir COMPLETA, incluidos campos inactivos.
2026-11-27T04:21:49.5012517Z  	    -- Una versión parcial también se rechaza; no se rellena silenciosamente.
2026-11-27T04:21:49.5012670Z  	    IF (v_plantilla.tipo_informe_id,v_plantilla.area_id,v_plantilla.activa,
2026-11-27T04:21:49.5012788Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:21:49.5012929Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
2026-11-27T04:21:49.5013088Z  	                        v_definicion->>'descripcion',v_definicion->'secciones_salida') THEN
2026-11-27T04:21:49.5013285Z  	      RAISE EXCEPTION 'La plantilla de inspección v1 existente difiere; revisar sin sobrescribir';
2026-11-27T04:21:49.5013488Z  	    END IF;
2026-11-27T04:21:49.5013723Z  	    SELECT COALESCE(jsonb_agg(jsonb_build_object(
2026-11-27T04:21:49.5013854Z  	        'clave',c.clave,'etiqueta',c.etiqueta,'tipo_dato',c.tipo_dato,
2026-11-27T04:21:49.5014060Z  	        'obligatorio',c.obligatorio,'orden',c.orden,'configuracion',c.configuracion,'activo',c.activo)
2026-11-27T04:21:49.5014147Z  	        ORDER BY c.orden,c.clave),'[]'::jsonb)
2026-11-27T04:21:49.5014342Z  	      INTO v_campos_actuales FROM public.campos_plantilla c WHERE c.plantilla_id=v_plantilla.id;
2026-11-27T04:21:49.5014477Z  	    IF v_campos_actuales IS DISTINCT FROM v_definicion->'campos' THEN
2026-11-27T04:21:49.5014725Z  	      RAISE EXCEPTION 'Los campos de inspección existentes difieren o están incompletos; revisar sin sobrescribir';
2026-11-27T04:21:49.5014784Z  	    END IF;
2026-11-27T04:21:49.5014928Z  	    RETURN; -- Coincide: cero escrituras, sin cambiar IDs ni timestamps.
2026-11-27T04:21:49.5014996Z  	  END IF;
2026-11-27T04:21:49.5015093Z  	
2026-11-27T04:21:49.5015349Z  	  INSERT INTO public.plantillas(nombre,tipo_informe_id,area_id,version,activa,descripcion,secciones_salida)
2026-11-27T04:21:49.5015531Z  	    VALUES (v_definicion->>'nombre',v_tipo_id,v_area_id,(v_definicion->>'version')::integer,
2026-11-27T04:21:49.5015739Z  	            (v_definicion->>'activa')::boolean,v_definicion->>'descripcion',v_definicion->'secciones_salida')
2026-11-27T04:21:49.5015822Z  	    RETURNING id INTO v_plantilla_id;
2026-11-27T04:21:49.5016089Z  	  INSERT INTO public.campos_plantilla(plantilla_id,clave,etiqueta,tipo_dato,obligatorio,orden,configuracion,activo)
2026-11-27T04:21:49.5016319Z  	    SELECT v_plantilla_id,c.clave,c.etiqueta,c.tipo_dato,c.obligatorio,c.orden,c.configuracion,c.activo
2026-11-27T04:21:49.5016428Z  	    FROM jsonb_to_recordset(v_definicion->'campos') AS c(
2026-11-27T04:21:49.5016674Z  	      clave text,etiqueta text,tipo_dato text,obligatorio boolean,orden integer,configuracion jsonb,activo boolean);
2026-11-27T04:21:49.5016839Z  	  -- Si cualquier inserción falla, PostgreSQL revierte TODA esta sentencia DO.
2026-11-27T04:21:49.5016897Z  	END
