2026-11-27T04:21:49.5032063Z  	FROM naxji_fuentes_v2 v CROSS JOIN public.plantillas p
2026-11-27T04:21:49.5032189Z  	WHERE p.nombre='Informe Técnico – Piloto NAXJI' AND p.version=2
2026-11-27T04:21:49.5032286Z  	ON CONFLICT(plantilla_id,clave) DO NOTHING;
