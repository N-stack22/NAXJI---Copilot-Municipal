2026-11-27T04:21:49.4327251Z  	    -- Una versión parcial también se rechaza; no se rellena silenciosamente.
2026-11-27T04:21:49.4327624Z  	    IF (v_plantilla.tipo_informe_id,v_plantilla.area_id,v_plantilla.activa,
2026-11-27T04:21:49.4327970Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:21:49.4328300Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
