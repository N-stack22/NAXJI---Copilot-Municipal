2026-11-27T04:21:49.4987667Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:21:49.4987757Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
