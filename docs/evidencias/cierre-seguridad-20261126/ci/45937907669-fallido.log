2026-11-27T04:06:58.6815856Z  	CREATE OR REPLACE FUNCTION public.naxji_secciones_salida_validas(valor jsonb)
2026-11-27T04:06:58.6816482Z  	RETURNS boolean LANGUAGE plpgsql IMMUTABLE SET search_path = pg_catalog AS $$
2026-11-27T04:06:58.6816938Z  	DECLARE
2026-11-27T04:06:58.6817154Z  	  seccion jsonb;
2026-11-27T04:06:58.6817423Z  	  claves text[] := ARRAY[]::text[];
2026-11-27T04:06:58.6817726Z  	  clave text;
2026-11-27T04:06:58.6818108Z  	  -- Caracteres Unicode que Python considera blancos (str.strip()). btrim()
2026-11-27T04:06:58.6818846Z  	  -- sin segundo argumento solo elimina U+0020; POSIX depende del locale.
2026-11-27T04:06:58.6819760Z  	  espacios constant text := U&'\0009\000A\000B\000C\000D\001C\001D\001E\001F\0020\0085\00A0\1680\2000\2001\2002\2003\2004\2005\2006\2007\2008\2009\200A\2028\2029\202F\205F\3000';
2026-11-27T04:06:58.6820554Z  	BEGIN
2026-11-27T04:06:58.6820823Z  	  IF valor IS NULL THEN RETURN true; END IF;
2026-11-27T04:06:58.6821272Z  	  IF jsonb_typeof(valor) <> 'array' THEN RETURN false; END IF;
2026-11-27T04:06:58.6821837Z  	  IF jsonb_array_length(valor) NOT BETWEEN 1 AND 100 THEN RETURN false; END IF;
2026-11-27T04:06:58.6822418Z  	  FOR seccion IN SELECT * FROM jsonb_array_elements(valor) LOOP
2026-11-27T04:06:58.6822933Z  	    IF jsonb_typeof(seccion) <> 'object' THEN RETURN false; END IF;
2026-11-27T04:06:58.6823429Z  	    IF NOT (seccion ?& ARRAY['clave','titulo','obligatoria'])
2026-11-27T04:06:58.6823979Z  	       OR (seccion - ARRAY['clave','titulo','obligatoria']) <> '{}'::jsonb THEN RETURN false; END IF;
2026-11-27T04:06:58.6824648Z  	    IF jsonb_typeof(seccion->'clave') <> 'string'
2026-11-27T04:06:58.6825022Z  	       OR jsonb_typeof(seccion->'titulo') <> 'string'
2026-11-27T04:06:58.6825505Z  	       OR jsonb_typeof(seccion->'obligatoria') <> 'boolean' THEN RETURN false; END IF;
2026-11-27T04:06:58.6825825Z  	    clave := seccion->>'clave';
2026-11-27T04:06:58.6826099Z  	    IF clave !~ '^[a-z][a-z0-9_]{0,79}$'
2026-11-27T04:06:58.6826512Z  	       OR clave = ANY(ARRAY['encabezado','datos','contexto','plantilla','instrucciones'])
2026-11-27T04:06:58.6827107Z  	       OR clave = ANY(claves)
2026-11-27T04:06:58.6827436Z  	       OR length(btrim(seccion->>'titulo', espacios)) = 0
2026-11-27T04:06:58.6827865Z  	       OR length(seccion->>'titulo') > 150 THEN RETURN false; END IF;
2026-11-27T04:06:58.6828280Z  	    claves := array_append(claves, clave);
2026-11-27T04:06:58.6828610Z  	  END LOOP;
2026-11-27T04:06:58.6828907Z  	  RETURN true;
2026-11-27T04:06:58.6847590Z  	END $$;
