2026-11-27T04:06:58.7188230Z  	  $definicion_inspeccion$::jsonb;
2026-11-27T04:06:58.7188298Z  	  v_tipo_id uuid;
2026-11-27T04:06:58.7188369Z  	  v_area_id uuid;
2026-11-27T04:06:58.7188461Z  	  v_plantilla public.plantillas%ROWTYPE;
2026-11-27T04:06:58.7188534Z  	  v_campos_actuales jsonb;
2026-11-27T04:06:58.7188610Z  	  v_plantilla_id uuid;
2026-11-27T04:06:58.7188678Z  	BEGIN
2026-11-27T04:06:58.7188774Z  	  PERFORM set_config('lock_timeout', '5s', true);
2026-11-27T04:06:58.7188870Z  	  PERFORM pg_advisory_xact_lock(20261001, 3);
2026-11-27T04:06:58.7189036Z  	
2026-11-27T04:06:58.7189214Z  	  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:06:58.7189356Z  	      AND table_name='plantillas' AND column_name='secciones_salida')
2026-11-27T04:06:58.7189534Z  	    OR NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:06:58.7189670Z  	      AND table_name='versiones_informe' AND column_name='titulo') THEN
2026-11-27T04:06:58.7189905Z  	    RAISE EXCEPTION 'Faltan las migraciones de secciones o título por versión; revisar prerrequisitos';
2026-11-27T04:06:58.7189972Z  	  END IF;
2026-11-27T04:06:58.7190076Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:06:58.7190214Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:06:58.7190330Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:06:58.7190455Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:06:58.7190558Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
2026-11-27T04:06:58.7190784Z  	    RAISE EXCEPTION 'Se requieren INFORME_INSPECCION y MDT_SGGA activos; no se insertaron registros';
2026-11-27T04:06:58.7190847Z  	  END IF;
2026-11-27T04:06:58.7190914Z  	
2026-11-27T04:06:58.7191019Z  	  SELECT * INTO v_plantilla FROM public.plantillas
2026-11-27T04:06:58.7191203Z  	    WHERE nombre=v_definicion->>'nombre' AND version=(v_definicion->>'version')::integer
2026-11-27T04:06:58.7191278Z  	    FOR UPDATE;
2026-11-27T04:06:58.7191350Z  	  IF FOUND THEN
2026-11-27T04:06:58.7191521Z  	    -- Una versión existente debe coincidir COMPLETA, incluidos campos inactivos.
2026-11-27T04:06:58.7191679Z  	    -- Una versión parcial también se rechaza; no se rellena silenciosamente.
2026-11-27T04:06:58.7191834Z  	    IF (v_plantilla.tipo_informe_id,v_plantilla.area_id,v_plantilla.activa,
2026-11-27T04:06:58.7191959Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:06:58.7192120Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
2026-11-27T04:06:58.7192285Z  	                        v_definicion->>'descripcion',v_definicion->'secciones_salida') THEN
2026-11-27T04:06:58.7192491Z  	      RAISE EXCEPTION 'La plantilla de inspección v1 existente difiere; revisar sin sobrescribir';
2026-11-27T04:06:58.7192558Z  	    END IF;
2026-11-27T04:06:58.7192656Z  	    SELECT COALESCE(jsonb_agg(jsonb_build_object(
2026-11-27T04:06:58.7192867Z  	        'clave',c.clave,'etiqueta',c.etiqueta,'tipo_dato',c.tipo_dato,
2026-11-27T04:06:58.7193090Z  	        'obligatorio',c.obligatorio,'orden',c.orden,'configuracion',c.configuracion,'activo',c.activo)
2026-11-27T04:06:58.7193185Z  	        ORDER BY c.orden,c.clave),'[]'::jsonb)
2026-11-27T04:06:58.7193390Z  	      INTO v_campos_actuales FROM public.campos_plantilla c WHERE c.plantilla_id=v_plantilla.id;
2026-11-27T04:06:58.7193528Z  	    IF v_campos_actuales IS DISTINCT FROM v_definicion->'campos' THEN
2026-11-27T04:06:58.7193787Z  	      RAISE EXCEPTION 'Los campos de inspección existentes difieren o están incompletos; revisar sin sobrescribir';
2026-11-27T04:06:58.7193855Z  	    END IF;
2026-11-27T04:06:58.7194000Z  	    RETURN; -- Coincide: cero escrituras, sin cambiar IDs ni timestamps.
