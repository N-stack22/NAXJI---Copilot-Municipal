2026-11-27T04:11:49.6169036Z  	  $definicion_inspeccion$::jsonb;
2026-11-27T04:11:49.6169115Z  	  v_tipo_id uuid;
2026-11-27T04:11:49.6169185Z  	  v_area_id uuid;
2026-11-27T04:11:49.6169435Z  	  v_plantilla public.plantillas%ROWTYPE;
2026-11-27T04:11:49.6169564Z  	  v_campos_actuales jsonb;
2026-11-27T04:11:49.6169674Z  	  v_plantilla_id uuid;
2026-11-27T04:11:49.6169752Z  	BEGIN
2026-11-27T04:11:49.6169865Z  	  PERFORM set_config('lock_timeout', '5s', true);
2026-11-27T04:11:49.6169961Z  	  PERFORM pg_advisory_xact_lock(20261001, 3);
2026-11-27T04:11:49.6170033Z  	
2026-11-27T04:11:49.6170222Z  	  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:11:49.6170367Z  	      AND table_name='plantillas' AND column_name='secciones_salida')
2026-11-27T04:11:49.6170648Z  	    OR NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:11:49.6170811Z  	      AND table_name='versiones_informe' AND column_name='titulo') THEN
2026-11-27T04:11:49.6171061Z  	    RAISE EXCEPTION 'Faltan las migraciones de secciones o título por versión; revisar prerrequisitos';
2026-11-27T04:11:49.6171174Z  	  END IF;
2026-11-27T04:11:49.6171348Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:11:49.6171520Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:11:49.6171640Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:11:49.6171775Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:11:49.6171875Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
2026-11-27T04:11:49.6172095Z  	    RAISE EXCEPTION 'Se requieren INFORME_INSPECCION y MDT_SGGA activos; no se insertaron registros';
2026-11-27T04:11:49.6172167Z  	  END IF;
2026-11-27T04:11:49.6172234Z  	
2026-11-27T04:11:49.6172340Z  	  SELECT * INTO v_plantilla FROM public.plantillas
2026-11-27T04:11:49.6172541Z  	    WHERE nombre=v_definicion->>'nombre' AND version=(v_definicion->>'version')::integer
2026-11-27T04:11:49.6172622Z  	    FOR UPDATE;
2026-11-27T04:11:49.6172689Z  	  IF FOUND THEN
2026-11-27T04:11:49.6172878Z  	    -- Una versión existente debe coincidir COMPLETA, incluidos campos inactivos.
2026-11-27T04:11:49.6173039Z  	    -- Una versión parcial también se rechaza; no se rellena silenciosamente.
2026-11-27T04:11:49.6173199Z  	    IF (v_plantilla.tipo_informe_id,v_plantilla.area_id,v_plantilla.activa,
2026-11-27T04:11:49.6173385Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:11:49.6173570Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
2026-11-27T04:11:49.6173741Z  	                        v_definicion->>'descripcion',v_definicion->'secciones_salida') THEN
2026-11-27T04:11:49.6173960Z  	      RAISE EXCEPTION 'La plantilla de inspección v1 existente difiere; revisar sin sobrescribir';
2026-11-27T04:11:49.6174035Z  	    END IF;
2026-11-27T04:11:49.6174262Z  	    SELECT COALESCE(jsonb_agg(jsonb_build_object(
2026-11-27T04:11:49.6174413Z  	        'clave',c.clave,'etiqueta',c.etiqueta,'tipo_dato',c.tipo_dato,
2026-11-27T04:11:49.6174636Z  	        'obligatorio',c.obligatorio,'orden',c.orden,'configuracion',c.configuracion,'activo',c.activo)
2026-11-27T04:11:49.6174726Z  	        ORDER BY c.orden,c.clave),'[]'::jsonb)
2026-11-27T04:11:49.6174942Z  	      INTO v_campos_actuales FROM public.campos_plantilla c WHERE c.plantilla_id=v_plantilla.id;
2026-11-27T04:11:49.6175086Z  	    IF v_campos_actuales IS DISTINCT FROM v_definicion->'campos' THEN
2026-11-27T04:11:49.6175349Z  	      RAISE EXCEPTION 'Los campos de inspección existentes difieren o están incompletos; revisar sin sobrescribir';
2026-11-27T04:11:49.6175423Z  	    END IF;
2026-11-27T04:11:49.6175578Z  	    RETURN; -- Coincide: cero escrituras, sin cambiar IDs ni timestamps.
2026-11-27T04:11:49.6175647Z  	  END IF;
