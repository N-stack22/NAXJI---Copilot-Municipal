2026-11-27T04:11:49.5680250Z  	  $definicion_inspeccion$::jsonb;
2026-11-27T04:11:49.5680322Z  	  v_tipo_id uuid;
2026-11-27T04:11:49.5680386Z  	  v_area_id uuid;
2026-11-27T04:11:49.5680478Z  	  v_plantilla public.plantillas%ROWTYPE;
2026-11-27T04:11:49.5680559Z  	  v_campos_actuales jsonb;
2026-11-27T04:11:49.5680645Z  	  v_plantilla_id uuid;
2026-11-27T04:11:49.5680714Z  	BEGIN
2026-11-27T04:11:49.5680816Z  	  PERFORM set_config('lock_timeout', '5s', true);
2026-11-27T04:11:49.5680908Z  	  PERFORM pg_advisory_xact_lock(20261001, 3);
2026-11-27T04:11:49.5680973Z  	
2026-11-27T04:11:49.5681150Z  	  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:11:49.5681288Z  	      AND table_name='plantillas' AND column_name='secciones_salida')
2026-11-27T04:11:49.5681464Z  	    OR NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:11:49.5681606Z  	      AND table_name='versiones_informe' AND column_name='titulo') THEN
2026-11-27T04:11:49.5681827Z  	    RAISE EXCEPTION 'Faltan las migraciones de secciones o título por versión; revisar prerrequisitos';
2026-11-27T04:11:49.5681896Z  	  END IF;
2026-11-27T04:11:49.5682007Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:11:49.5682253Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:11:49.5682375Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:11:49.5682505Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:11:49.5682599Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
2026-11-27T04:11:49.5682825Z  	    RAISE EXCEPTION 'Se requieren INFORME_INSPECCION y MDT_SGGA activos; no se insertaron registros';
2026-11-27T04:11:49.5682893Z  	  END IF;
2026-11-27T04:11:49.5682955Z  	
2026-11-27T04:11:49.5683065Z  	  SELECT * INTO v_plantilla FROM public.plantillas
2026-11-27T04:11:49.5683252Z  	    WHERE nombre=v_definicion->>'nombre' AND version=(v_definicion->>'version')::integer
2026-11-27T04:11:49.5683319Z  	    FOR UPDATE;
2026-11-27T04:11:49.5683392Z  	  IF FOUND THEN
2026-11-27T04:11:49.5683571Z  	    -- Una versión existente debe coincidir COMPLETA, incluidos campos inactivos.
2026-11-27T04:11:49.5683728Z  	    -- Una versión parcial también se rechaza; no se rellena silenciosamente.
2026-11-27T04:11:49.5683991Z  	    IF (v_plantilla.tipo_informe_id,v_plantilla.area_id,v_plantilla.activa,
2026-11-27T04:11:49.5684126Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:11:49.5684279Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
2026-11-27T04:11:49.5684443Z  	                        v_definicion->>'descripcion',v_definicion->'secciones_salida') THEN
2026-11-27T04:11:49.5684652Z  	      RAISE EXCEPTION 'La plantilla de inspección v1 existente difiere; revisar sin sobrescribir';
2026-11-27T04:11:49.5684715Z  	    END IF;
2026-11-27T04:11:49.5684818Z  	    SELECT COALESCE(jsonb_agg(jsonb_build_object(
2026-11-27T04:11:49.5684954Z  	        'clave',c.clave,'etiqueta',c.etiqueta,'tipo_dato',c.tipo_dato,
2026-11-27T04:11:49.5685162Z  	        'obligatorio',c.obligatorio,'orden',c.orden,'configuracion',c.configuracion,'activo',c.activo)
2026-11-27T04:11:49.5685253Z  	        ORDER BY c.orden,c.clave),'[]'::jsonb)
2026-11-27T04:11:49.5685469Z  	      INTO v_campos_actuales FROM public.campos_plantilla c WHERE c.plantilla_id=v_plantilla.id;
2026-11-27T04:11:49.5685608Z  	    IF v_campos_actuales IS DISTINCT FROM v_definicion->'campos' THEN
2026-11-27T04:11:49.5685856Z  	      RAISE EXCEPTION 'Los campos de inspección existentes difieren o están incompletos; revisar sin sobrescribir';
2026-11-27T04:11:49.5685927Z  	    END IF;
2026-11-27T04:11:49.5686077Z  	    RETURN; -- Coincide: cero escrituras, sin cambiar IDs ni timestamps.
2026-11-27T04:11:49.5686139Z  	  END IF;
2026-11-27T04:11:49.5686206Z  	
2026-11-27T04:11:49.5686463Z  	  INSERT INTO public.plantillas(nombre,tipo_informe_id,area_id,version,activa,descripcion,secciones_salida)
2026-11-27T04:11:49.5686646Z  	    VALUES (v_definicion->>'nombre',v_tipo_id,v_area_id,(v_definicion->>'version')::integer,
2026-11-27T04:11:49.5686870Z  	            (v_definicion->>'activa')::boolean,v_definicion->>'descripcion',v_definicion->'secciones_salida')
2026-11-27T04:11:49.5686963Z  	    RETURNING id INTO v_plantilla_id;
2026-11-27T04:11:49.5687246Z  	  INSERT INTO public.campos_plantilla(plantilla_id,clave,etiqueta,tipo_dato,obligatorio,orden,configuracion,activo)
2026-11-27T04:11:49.5687491Z  	    SELECT v_plantilla_id,c.clave,c.etiqueta,c.tipo_dato,c.obligatorio,c.orden,c.configuracion,c.activo
2026-11-27T04:11:49.5687608Z  	    FROM jsonb_to_recordset(v_definicion->'campos') AS c(
2026-11-27T04:11:49.5687862Z  	      clave text,etiqueta text,tipo_dato text,obligatorio boolean,orden integer,configuracion jsonb,activo boolean);
2026-11-27T04:11:49.5688035Z  	  -- Si cualquier inserción falla, PostgreSQL revierte TODA esta sentencia DO.
2026-11-27T04:11:49.5688103Z  	END
