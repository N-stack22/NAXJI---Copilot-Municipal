2026-11-27T04:11:49.5511874Z  	    -- Una versión parcial también se rechaza; no se rellena silenciosamente.
2026-11-27T04:11:49.5512256Z  	    IF (v_plantilla.tipo_informe_id,v_plantilla.area_id,v_plantilla.activa,
2026-11-27T04:11:49.5512618Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:11:49.5512964Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
2026-11-27T04:11:49.5513340Z  	                        v_definicion->>'descripcion',v_definicion->'secciones_salida') THEN
