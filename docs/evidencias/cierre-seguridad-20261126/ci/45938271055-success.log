2026-11-27T04:11:49.5658219Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:11:49.5658331Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:11:49.5658464Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
