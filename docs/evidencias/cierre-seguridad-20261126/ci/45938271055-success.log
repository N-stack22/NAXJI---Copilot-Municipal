2026-11-27T04:11:49.6187406Z  	      {"clave":"objetivo","titulo":"Objetivo del informe","obligatoria":true},
2026-11-27T04:11:49.6187570Z  	      {"clave":"analisis_tecnico","titulo":"Análisis técnico","obligatoria":true},
2026-11-27T04:11:49.6187710Z  	      {"clave":"conclusiones","titulo":"Conclusiones","obligatoria":true},
2026-11-27T04:11:49.6187912Z  	      {"clave":"recomendaciones","titulo":"Recomendaciones","obligatoria":false}]'::jsonb) THEN
2026-11-27T04:11:49.6188099Z  	    RAISE EXCEPTION 'La versión 2 existente tiene otra definición; revisar manualmente';
2026-11-27T04:11:49.6188174Z  	  END IF;
2026-11-27T04:11:49.6188329Z  	END $$;
2026-11-27T04:11:49.6188396Z  	
2026-11-27T04:11:49.6188604Z  	-- Tabla temporal solo para comparar la definición esperada; no altera el esquema público.
2026-11-27T04:11:49.6188722Z  	CREATE TEMP TABLE naxji_fuentes_v2 ON COMMIT DROP AS
2026-11-27T04:11:49.6188797Z  	SELECT * FROM (VALUES
2026-11-27T04:11:49.6188939Z  	  ('estado_resultados','Información disponible','select',true,1,
2026-11-27T04:11:49.6189631Z  	   '{"opciones":["Sin resultados de inspección","Información parcial por verificar","Resultados documentados disponibles"],"ayuda":"Indique si existen resultados. Elegir una opción no acredita hechos ni sustituye sus fuentes."}'::jsonb),
2026-11-27T04:11:49.6189777Z  	  ('lugar_referencia','Lugar de referencia conocido','text',false,2,
2026-11-27T04:11:49.6190026Z  	   '{"ayuda":"Opcional. Identifique el lugar solo si lo conoce; no implica que haya sido inspeccionado."}'::jsonb),
2026-11-27T04:11:49.6190165Z  	  ('fecha_referencia','Fecha de referencia conocida','date',false,3,
2026-11-27T04:11:49.6190511Z  	   '{"ayuda":"Opcional. Fecha del hecho o documento aportado; no supone una inspección realizada."}'::jsonb),
2026-11-27T04:11:49.6190672Z  	  ('hechos_conocidos','Hechos y resultados conocidos','textarea',false,4,
2026-11-27T04:11:49.6191084Z  	   '{"rol_fuente":"hechos","ayuda":"Opcional. Describa solo hechos aportados, su origen y qué falta comprobar. Si no hay resultados, déjelo vacío o indíquelo expresamente."}'::jsonb),
2026-11-27T04:11:49.6191262Z  	  ('referencias_conocidas','Documentos y referencias conocidos','textarea',false,5,
2026-11-27T04:11:49.6191701Z  	   '{"rol_fuente":"referencias","ayuda":"Opcional. Identifique documentos, enlaces o extractos disponibles. Un número o enlace no acredita su contenido, vigencia ni aplicabilidad."}'::jsonb),
2026-11-27T04:11:49.6191920Z  	  ('informacion_pendiente','Información pendiente de obtener o verificar','textarea',false,6,
2026-11-27T04:11:49.6192197Z  	   '{"ayuda":"Opcional. Señale datos faltantes. No necesita redactar antecedentes, análisis ni conclusiones."}'::jsonb)
2026-11-27T04:11:49.6192352Z  	) AS v(clave,etiqueta,tipo_dato,obligatorio,orden,configuracion);
