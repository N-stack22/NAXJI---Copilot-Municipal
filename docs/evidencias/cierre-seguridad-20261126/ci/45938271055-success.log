2026-11-27T04:11:49.5327965Z  	CREATE OR REPLACE FUNCTION public.naxji_secciones_salida_validas(valor jsonb)
2026-11-27T04:11:49.5328582Z  	RETURNS boolean LANGUAGE plpgsql IMMUTABLE SET search_path = pg_catalog AS $$
2026-11-27T04:11:49.5329042Z  	DECLARE
2026-11-27T04:11:49.5329274Z  	  seccion jsonb;
2026-11-27T04:11:49.5329845Z  	  claves text[] := ARRAY[]::text[];
2026-11-27T04:11:49.5330160Z  	  clave text;
2026-11-27T04:11:49.5330549Z  	  -- Caracteres Unicode que Python considera blancos (str.strip()). btrim()
2026-11-27T04:11:49.5331154Z  	  -- sin segundo argumento solo elimina U+0020; POSIX depende del locale.
2026-11-27T04:11:49.5332058Z  	  espacios constant text := U&'\0009\000A\000B\000C\000D\001C\001D\001E\001F\0020\0085\00A0\1680\2000\2001\2002\2003\2004\2005\2006\2007\2008\2009\200A\2028\2029\202F\205F\3000';
2026-11-27T04:11:49.5332844Z  	BEGIN
2026-11-27T04:11:49.5333104Z  	  IF valor IS NULL THEN RETURN true; END IF;
2026-11-27T04:11:49.5333549Z  	  IF jsonb_typeof(valor) <> 'array' THEN RETURN false; END IF;
2026-11-27T04:11:49.5334117Z  	  IF jsonb_array_length(valor) NOT BETWEEN 1 AND 100 THEN RETURN false; END IF;
2026-11-27T04:11:49.5334677Z  	  FOR seccion IN SELECT * FROM jsonb_array_elements(valor) LOOP
2026-11-27T04:11:49.5335182Z  	    IF jsonb_typeof(seccion) <> 'object' THEN RETURN false; END IF;
2026-11-27T04:11:49.5335677Z  	    IF NOT (seccion ?& ARRAY['clave','titulo','obligatoria'])
2026-11-27T04:11:49.5336273Z  	       OR (seccion - ARRAY['clave','titulo','obligatoria']) <> '{}'::jsonb THEN RETURN false; END IF;
2026-11-27T04:11:49.5336844Z  	    IF jsonb_typeof(seccion->'clave') <> 'string'
2026-11-27T04:11:49.5337240Z  	       OR jsonb_typeof(seccion->'titulo') <> 'string'
2026-11-27T04:11:49.5337730Z  	       OR jsonb_typeof(seccion->'obligatoria') <> 'boolean' THEN RETURN false; END IF;
2026-11-27T04:11:49.5338210Z  	    clave := seccion->>'clave';
2026-11-27T04:11:49.5338515Z  	    IF clave !~ '^[a-z][a-z0-9_]{0,79}$'
2026-11-27T04:11:49.5338990Z  	       OR clave = ANY(ARRAY['encabezado','datos','contexto','plantilla','instrucciones'])
2026-11-27T04:11:49.5339599Z  	       OR clave = ANY(claves)
2026-11-27T04:11:49.5339940Z  	       OR length(btrim(seccion->>'titulo', espacios)) = 0
2026-11-27T04:11:49.5340394Z  	       OR length(seccion->>'titulo') > 150 THEN RETURN false; END IF;
2026-11-27T04:11:49.5340791Z  	    claves := array_append(claves, clave);
2026-11-27T04:11:49.5341163Z  	  END LOOP;
2026-11-27T04:11:49.5341406Z  	  RETURN true;
2026-11-27T04:11:49.5341642Z  	END $$;
2026-11-27T04:11:49.5341866Z  	
2026-11-27T04:11:49.5342289Z  	-- Cambiar una función IMMUTABLE no revalida filas existentes. Recrear las
2026-11-27T04:11:49.5342972Z  	-- restricciones fuerza su comprobación y el rollback si alguna fila no cumple.
2026-11-27T04:11:49.5343694Z  	ALTER TABLE public.plantillas DROP CONSTRAINT IF EXISTS chk_plantilla_secciones_salida;
2026-11-27T04:11:49.5344468Z  	ALTER TABLE public.plantillas ADD CONSTRAINT chk_plantilla_secciones_salida
2026-11-27T04:11:49.5345321Z  	  CHECK (public.naxji_secciones_salida_validas(secciones_salida)) NOT VALID;
2026-11-27T04:11:49.5346047Z  	ALTER TABLE public.versiones_informe DROP CONSTRAINT IF EXISTS chk_version_secciones_salida;
2026-11-27T04:11:49.5346931Z  	ALTER TABLE public.versiones_informe ADD CONSTRAINT chk_version_secciones_salida
2026-11-27T04:11:49.5347469Z  	  CHECK (public.naxji_secciones_salida_validas(secciones_salida)) NOT VALID;
2026-11-27T04:11:49.5347891Z  	ALTER TABLE public.plantillas VALIDATE CONSTRAINT chk_plantilla_secciones_salida;
2026-11-27T04:11:49.5348335Z  	ALTER TABLE public.versiones_informe VALIDATE CONSTRAINT chk_version_secciones_salida;
2026-11-27T04:11:49.5348668Z  	COMMIT;
