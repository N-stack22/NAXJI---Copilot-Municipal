2026-11-27T04:11:49.5510363Z  	  SELECT * INTO v_plantilla FROM public.plantillas
2026-11-27T04:11:49.5510716Z  	    WHERE nombre=v_definicion->>'nombre' AND version=(v_definicion->>'version')::integer
2026-11-27T04:11:49.5511034Z  	    FOR UPDATE;
2026-11-27T04:11:49.5511201Z  	  IF FOUND THEN
