2026-11-27T04:11:49.6175971Z  	  INSERT INTO public.plantillas(nombre,tipo_informe_id,area_id,version,activa,descripcion,secciones_salida)
2026-11-27T04:11:49.6176272Z  	    VALUES (v_definicion->>'nombre',v_tipo_id,v_area_id,(v_definicion->>'version')::integer,
2026-11-27T04:11:49.6176505Z  	            (v_definicion->>'activa')::boolean,v_definicion->>'descripcion',v_definicion->'secciones_salida')
2026-11-27T04:11:49.6176596Z  	    RETURNING id INTO v_plantilla_id;
2026-11-27T04:11:49.6176893Z  	  INSERT INTO public.campos_plantilla(plantilla_id,clave,etiqueta,tipo_dato,obligatorio,orden,configuracion,activo)
2026-11-27T04:11:49.6177141Z  	    SELECT v_plantilla_id,c.clave,c.etiqueta,c.tipo_dato,c.obligatorio,c.orden,c.configuracion,c.activo
2026-11-27T04:11:49.6177265Z  	    FROM jsonb_to_recordset(v_definicion->'campos') AS c(
2026-11-27T04:11:49.6177532Z  	      clave text,etiqueta text,tipo_dato text,obligatorio boolean,orden integer,configuracion jsonb,activo boolean);
2026-11-27T04:11:49.6177707Z  	  -- Si cualquier inserción falla, PostgreSQL revierte TODA esta sentencia DO.
2026-11-27T04:11:49.6177786Z  	END
