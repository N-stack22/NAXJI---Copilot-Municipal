2026-11-27T04:11:49.5634293Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:11:49.5634430Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:11:49.5634539Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:11:49.5634667Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:11:49.5634765Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
