2026-11-27T04:11:49.5515418Z  	        ORDER BY c.orden,c.clave),'[]'::jsonb)
2026-11-27T04:11:49.5515782Z  	      INTO v_campos_actuales FROM public.campos_plantilla c WHERE c.plantilla_id=v_plantilla.id;
2026-11-27T04:11:49.5516197Z  	    IF v_campos_actuales IS DISTINCT FROM v_definicion->'campos' THEN
2026-11-27T04:11:49.5516651Z  	      RAISE EXCEPTION 'Los campos de inspección existentes difieren o están incompletos; revisar sin sobrescribir';
2026-11-27T04:11:49.5517439Z  	    END IF;
2026-11-27T04:11:49.5517693Z  	    RETURN; -- Coincide: cero escrituras, sin cambiar IDs ni timestamps.
2026-11-27T04:11:49.5517977Z  	  END IF;
