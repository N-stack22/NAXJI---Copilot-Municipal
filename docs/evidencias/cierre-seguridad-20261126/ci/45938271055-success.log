2026-11-27T04:11:49.6192816Z  	    LEFT JOIN naxji_fuentes_v2 v ON v.clave=c.clave
2026-11-27T04:11:49.6192954Z  	    WHERE p.nombre='Informe Técnico – Piloto NAXJI' AND p.version=2
2026-11-27T04:11:49.6193186Z  	    AND (v.clave IS NULL OR (c.etiqueta,c.tipo_dato,c.obligatorio,c.orden,c.configuracion,c.activo)
2026-11-27T04:11:49.6193409Z  	      IS DISTINCT FROM (v.etiqueta,v.tipo_dato,v.obligatorio,v.orden,v.configuracion,true))) THEN
2026-11-27T04:11:49.6193591Z  	    RAISE EXCEPTION 'Los campos de v2 existentes difieren; no se alteraron registros';
2026-11-27T04:11:49.6193659Z  	  END IF;
2026-11-27T04:11:49.6193727Z  	END $$;
