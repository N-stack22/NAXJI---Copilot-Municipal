2026-11-27T04:11:49.5505113Z  	  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:11:49.5505498Z  	      AND table_name='plantillas' AND column_name='secciones_salida')
2026-11-27T04:11:49.5505881Z  	    OR NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public'
2026-11-27T04:11:49.5506386Z  	      AND table_name='versiones_informe' AND column_name='titulo') THEN
2026-11-27T04:11:49.5506824Z  	    RAISE EXCEPTION 'Faltan las migraciones de secciones o título por versión; revisar prerrequisitos';
2026-11-27T04:11:49.5507183Z  	  END IF;
2026-11-27T04:11:49.5507897Z  	  SELECT id INTO v_tipo_id FROM public.tipos_informe
2026-11-27T04:11:49.5508204Z  	    WHERE codigo=v_definicion->>'tipo_codigo' AND activo FOR SHARE;
2026-11-27T04:11:49.5508521Z  	  SELECT id INTO v_area_id FROM public.areas_municipales
2026-11-27T04:11:49.5508833Z  	    WHERE codigo=v_definicion->>'area_codigo' AND activo FOR SHARE;
2026-11-27T04:11:49.5509127Z  	  IF v_tipo_id IS NULL OR v_area_id IS NULL THEN
2026-11-27T04:11:49.5509653Z  	    RAISE EXCEPTION 'Se requieren INFORME_INSPECCION y MDT_SGGA activos; no se insertaron registros';
