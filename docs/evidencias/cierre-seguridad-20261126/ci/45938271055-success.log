2026-11-27T04:11:49.5521200Z  	    SELECT v_plantilla_id,c.clave,c.etiqueta,c.tipo_dato,c.obligatorio,c.orden,c.configuracion,c.activo
2026-11-27T04:11:49.5521632Z  	    FROM jsonb_to_recordset(v_definicion->'campos') AS c(
