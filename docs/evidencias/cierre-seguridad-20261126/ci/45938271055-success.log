2026-11-27T04:11:49.5635888Z  	    -- Una versión parcial también se rechaza; no se rellena silenciosamente.
2026-11-27T04:11:49.5636044Z  	    IF (v_plantilla.tipo_informe_id,v_plantilla.area_id,v_plantilla.activa,
2026-11-27T04:11:49.5636169Z  	        v_plantilla.descripcion,v_plantilla.secciones_salida)
2026-11-27T04:11:49.5636323Z  	      IS DISTINCT FROM (v_tipo_id,v_area_id,(v_definicion->>'activa')::boolean,
